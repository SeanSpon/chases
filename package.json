{
  "name": "seezee-autocart",
  "version": "0.2.0",
  "private": true,
  "description": "Local multi-product restock watcher with configurable Playwright checkout",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.cjs && node --check src/monitor.cjs && node --check src/preload.cjs && node --check src/renderer.js && node --check src/checkout.cjs && node --check src/settings.cjs && node --check src/setup.cjs",
    "dist:win": "electron-builder --win nsis --publish never",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "playwright-core": "^1.58.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "studio.seezee.autocart",
    "productName": "AutoCart by SeeZee",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true,
    "artifactName": "AutoCart-Setup-${version}.${ext}"
  }
}

